# Ambiente
NODE_ENV=development
PORT=3011

# Caminhos (absolutos, fora do repo idealmente)
DATABASE_PATH=../data/rwz-drive.db
STORAGE_PATH=../storage

# Sessão
# Reservado para uso futuro (ex.: assinatura de cookies). Hoje as sessões
# usam IDs opacos aleatórios validados contra a tabela `sessions` no banco
# — a segurança não depende deste valor ainda, mas defina algo aleatório e
# longo mesmo assim (custa nada, e algumas dependências futuras podem vir
# a exigir).
SESSION_SECRET=troque-este-valor-por-algo-aleatorio-e-longo
SESSION_TTL_DAYS=7

# CORS - origem exata permitida (sem coringa em produção)
CORS_ORIGIN=http://127.0.0.1:3010

# Storage
STORAGE_QUOTA_GB=30

# Upload
UPLOAD_MAX_FILE_SIZE_MB=2048
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_REQUEST_SIZE_MB=4096

# Rate limiting
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_UPLOAD_WINDOW_MIN=1
RATE_LIMIT_UPLOAD_MAX=30

# Confiar em X-Forwarded-Proto/For (necessário atrás do Cloudflare Tunnel / proxy do Next.js)
TRUST_PROXY=true
